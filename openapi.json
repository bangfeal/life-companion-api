              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["type", "title", "status", "detail"],
                  "properties": {
                    "type": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "integer" },
                    "detail": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            }
