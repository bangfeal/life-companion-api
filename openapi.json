              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["type", "title", "status", "detail"],
                  "properties": {
                    "type": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "integer" },
                    "detail": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["type", "title", "status", "detail"],
                  "properties": {
                    "type": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "integer" },
                    "detail": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Registration could not be completed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["type", "title", "status", "detail"],
                  "properties": {
                    "type": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "integer" },
                    "detail": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 4 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["type", "title", "status", "detail"],
                  "properties": {
                    "type": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "integer" },
                    "detail": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type",
