          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": ["type", "title", "status", "detail"],
                  "properties": {
                    "type": { "type": "string" },
