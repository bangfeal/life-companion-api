      "patch": {
        "summary": "Update only the authenticated user profile",
        "tags": ["Identity"],
        "description": "Omitted fields remain unchanged. A null displayName clears it; timeZone must be UTC or a recognized IANA zone. Identity and email cannot be changed here.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "anyOf": [
                      { "type": "string", "minLength": 1, "maxLength": 100 },
                      { "type": "null" }
                    ]
                  },
                  "timeZone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "examples": ["Europe/Madrid"]
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "email", "createdAt", "profile"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "email": { "type": "string", "format": "email" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "profile": {
                      "type": "object",
                      "required": ["displayName", "timeZone"],
